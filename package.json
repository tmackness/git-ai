{
  "name": "@tma10011/git-ai",
  "version": "0.2.0",
  "description": "AI-generated git commit messages from the command line",
  "type": "module",
  "bin": {
    "gitai": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "postbuild": "node -e \"const f='dist/cli.js';const fs=require('fs');fs.chmodSync(f,0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/deepseek": "^0.2.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/groq": "^1.0.0",
    "@ai-sdk/mistral": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@ai-sdk/xai": "^1.0.0",
    "ai": "^4.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmackness/git-ai.git"
  },
  "homepage": "https://github.com/tmackness/git-ai#readme",
  "bugs": {
    "url": "https://github.com/tmackness/git-ai/issues"
  },
  "keywords": [
    "git",
    "ai",
    "commit",
    "cli",
    "openai",
    "anthropic",
    "google",
    "groq",
    "deepseek",
    "kimi",
    "qwen",
    "ollama",
    "conventional-commits"
  ],
  "author": "tmackness",
  "license": "MIT",
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
